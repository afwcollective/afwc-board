# AFWC Board environment
# Required in production (NODE_ENV=production); the app refuses to boot without it.
SESSION_SECRET=change-me-to-a-long-random-string

# Where app.db and uploads/ live. Defaults to ./data in development,
# should be the mounted volume (e.g. /data) in production.
DATA_DIR=./data

PORT=3000
NODE_ENV=development
