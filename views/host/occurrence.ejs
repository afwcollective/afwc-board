<section class="section">
  <div class="wrap">
    <p class="eyebrow">Hosting</p>
    <h1><%= ctx.rule.title %></h1>
    <p class="lede measure">
      <%= dates.formatDate(ctx.date + 'T12:00:00Z') %> — this one session only.
      Next <%= dates.weekdayName(ctx.rule.weekday) %> goes back to the group's
      usual arrangements on its own.
    </p>

    <% if (!ctx.mine) { %>
      <p class="notice">
        You're opening this as a leader.
        <%= ctx.host ? ctx.host.display_name + ' is the host for this date.' : 'Nobody is assigned to this date.' %>
      </p>
    <% } %>

    <% if (ctx.past) { %>
      <p class="notice">
        This session has already happened, so it's read-only now.
      </p>
      <dl class="meeting-facts">
        <dt>Started</dt><dd><%= dates.formatHhmm(values.time_hhmm) %></dd>
        <dt>Where</dt><dd><%= values.location_label || '—' %></dd>
        <% if (values.notes) { %><dt>Note</dt><dd><%= values.notes %></dd><% } %>
      </dl>
      <p class="section-foot"><a class="btn btn--sm" href="/host">Back to your sessions</a></p>
    <% } else { %>

      <%- include('../partials/form-errors', { errors: errors }) %>

      <form method="post" action="/host/recurring/<%= ctx.rule.id %>/<%= ctx.date %>"
            class="form meeting-form" id="host-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="meeting-form-grid">
          <div class="meeting-form-fields">
            <div class="field">
              <label for="time_hhmm">Start time <span class="optional">(Baltimore time)</span></label>
              <input id="time_hhmm" name="time_hhmm" type="time" required value="<%= values.time_hhmm %>">
              <p class="hint">Usually <%= dates.formatHhmm(ctx.rule.time_hhmm) %>. Change it if this one starts late.</p>
            </div>

            <div class="field">
              <label for="location_label">Where we're sitting</label>
              <input id="location_label" name="location_label" type="text" maxlength="120"
                     value="<%= values.location_label %>" placeholder="In front of Hilo">
              <p class="hint">Plain words beat coordinates — this is what people read first.</p>
            </div>

            <div class="field">
              <label for="notes">Note for the day <span class="optional">(optional)</span></label>
              <textarea id="notes" name="notes" rows="4" maxlength="2000"
                        placeholder="We're on the patio today."><%= values.notes %></textarea>
              <p class="hint">Shown on the front page under the meeting, for this date only.</p>
            </div>
          </div>

          <div class="meeting-form-map">
            <p class="section-label">The table</p>
            <%- include('../partials/floormap', {
                  markerX: values.map_x,
                  markerY: values.map_y,
                  interactive: true
                }) %>

            <input type="hidden" id="map_x" name="map_x" value="<%= values.map_x === null || values.map_x === undefined ? '' : values.map_x %>">
            <input type="hidden" id="map_y" name="map_y" value="<%= values.map_y === null || values.map_y === undefined ? '' : values.map_y %>">

            <p class="map-readout">
              <span class="eyebrow eyebrow--muted">Marker</span>
              <span id="map-readout-value" class="mono">
                <%= (values.map_x === null || values.map_x === undefined || values.map_x === '') ? 'not placed' : values.map_x + '% / ' + values.map_y + '%' %>
              </span>
              <button type="button" class="btn btn--sm" id="map-clear">Clear marker</button>
            </p>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Save this session</button>
          <a class="btn btn--sm" href="/host">Cancel</a>
        </div>
      </form>
    <% } %>
  </div>
</section>
