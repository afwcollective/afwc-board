<section class="section">
  <div class="wrap">
    <p class="eyebrow">Leaders only</p>
    <h1>Admin console</h1>
    <p class="lede measure">
      Everything the group needs is a button on this page. Nothing here needs a
      developer, and nothing here can be undone by accident — deletes are soft.
    </p>

    <div class="stat-row">
      <div class="stat">
        <span class="stat-k">Active members</span>
        <span class="stat-v"><%= memberCount %></span>
      </div>
      <div class="stat">
        <span class="stat-k">Leaders</span>
        <span class="stat-v"><%= leaderCount %></span>
      </div>
      <div class="stat">
        <span class="stat-k">Announcements</span>
        <span class="stat-v"><%= announcementCount %></span>
      </div>
      <div class="stat">
        <span class="stat-k">Group passcode</span>
        <span class="stat-v stat-v--sm"><%= passcodeSet ? 'Set' : 'Not set' %></span>
      </div>
    </div>

    <div class="admin-grid">
      <div class="card">
        <p class="eyebrow eyebrow--muted">Next meeting</p>
        <% if (meeting) { %>
          <p class="meeting-date"><%= dates.formatDate(meeting.starts_at) %></p>
          <p class="meeting-time"><%= dates.formatTime(meeting.starts_at) %></p>
          <p class="muted">
            <%= meeting.location_label || 'No table label set' %><br>
            <% if (meeting.map_x !== null && meeting.map_y !== null) { %>
              Marker at <%= meeting.map_x %>% / <%= meeting.map_y %>% of the map
            <% } else { %>
              No map marker yet — the front page will show the plain floor plan.
            <% } %>
          </p>
          <p>
            <% if (meeting.is_recurring) { %>
              <a class="btn btn--sm" href="/admin/recurring/<%= meeting.recurring_id %>/edit">Edit this weekly meeting</a>
            <% } else { %>
              <a class="btn btn--sm" href="/admin/meetings/<%= meeting.id %>/edit">Edit this meeting</a>
            <% } %>
          </p>
        <% } else { %>
          <p class="empty">Nothing scheduled. The front page is showing "no meeting scheduled yet".</p>
          <p><a class="btn btn--sm btn--primary" href="/admin/meetings/new">Schedule a meeting</a></p>
          <p><a class="btn btn--sm" href="/admin/recurring/new">Add a weekly meeting</a></p>
        <% } %>
      </div>

      <div class="card">
        <p class="eyebrow eyebrow--muted">Quick links</p>
        <ul class="link-list">
          <li><a href="/admin/members">Members — deactivate, promote, generate reset codes</a></li>
          <li><a href="/admin/meetings">Meetings — the weekly schedule, one-off dates, the map pin</a></li>
          <li><a href="/admin/announcements">Announcements — post, pin, remove</a></li>
          <li><a href="/admin/passcode">Group passcode — change the shared code</a></li>
          <li><a href="/admin/help">Leader handbook — how everything works</a></li>
          <li><a href="/">View the public front page</a></li>
        </ul>
      </div>

      <div class="card <%= backupStale ? 'card--warn' : '' %>">
        <p class="eyebrow eyebrow--muted">Backup</p>
        <p class="measure">
          One zip with the whole database and every uploaded draft — everything
          needed to stand the app back up on a fresh host. See the
          <a href="/admin/help#backups">leader handbook</a> for what's inside and
          how to restore it.
        </p>
        <p>
          <% if (lastBackupAt) { %>
            Last backed up
            <span class="badge <%= backupStale ? 'badge--warn' : 'badge--ok' %>">
              <%= dates.relative(lastBackupAt) %>
            </span>
          <% } else { %>
            <span class="badge badge--warn">Never backed up</span>
          <% } %>
        </p>
        <% if (backupStale) { %>
          <p class="small muted">
            It's been over 30 days (or never) — worth downloading a fresh copy today.
          </p>
        <% } %>
        <p>
          <a class="btn btn--sm btn--primary" href="/admin/backup.zip">Download backup</a>
        </p>
      </div>

      <div class="card">
        <p class="eyebrow eyebrow--muted">Reader watermark</p>
        <p class="measure">
          When on, every page in the draft reader shows a faint, tiled tag of
          the person reading it — their name and username, unselectable and
          too light to disturb reading. It never appears when printing (the
          reader is already blanked on paper) and it doesn’t affect who can
          copy or download anything; it just makes a leaked screenshot
          attributable.
        </p>
        <p>
          Currently
          <span class="badge <%= watermarkOn ? 'badge--ok' : 'badge--warn' %>">
            <%= watermarkOn ? 'On' : 'Off' %>
          </span>
        </p>
        <form method="post" action="/admin/settings/watermark" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--sm" type="submit"><%= watermarkOn ? 'Turn off' : 'Turn on' %></button>
        </form>
      </div>
    </div>
  </div>
</section>
