<section class="section">
  <div class="wrap">
    <p class="eyebrow">Leaders only</p>
    <h1>Meetings</h1>

    <p class="form-actions form-actions--top">
      <a class="btn btn--primary" href="/admin/meetings/new">Schedule a meeting</a>
      <a class="btn" href="/admin/recurring/new">Add a weekly meeting</a>
      <a class="btn btn--sm" href="/admin">Back to admin</a>
    </p>

    <p class="section-label" id="weekly">Weekly schedule</p>
    <p class="hint hint--block measure">
      A weekly meeting repeats forever — nobody has to enter next week's row. The
      front page always shows whichever comes first: a weekly one or a one-off
      below. To call off a single week, skip that date; to stop a rule for a
      while, deactivate it.
    </p>

    <% if (!rules.length) { %>
      <p class="empty">No weekly meetings yet. <a href="/admin/recurring/new">Add one</a> and it runs itself.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Every</th><th>Title</th><th>Table</th><th>Marker</th><th>Next</th><th class="right">Actions</th></tr>
          </thead>
          <tbody>
            <% rules.forEach(function (r) { %>
              <tr<%- r.is_active ? '' : ' class="is-cancelled"' %>>
                <td class="nowrap">
                  <%= dates.weekdayName(r.weekday) %><br>
                  <span class="mono small"><%= dates.formatHhmm(r.time_hhmm) %></span>
                </td>
                <td>
                  <%= r.title %>
                  <% if (!r.is_active) { %><br><span class="badge badge--warn">Paused</span><% } %>
                </td>
                <td><%= r.location_label || '—' %></td>
                <td class="mono small">
                  <%= (r.map_x !== null && r.map_y !== null) ? (r.map_x + ' / ' + r.map_y) : '—' %>
                </td>
                <td class="small">
                  <% if (!r.is_active) { %>
                    <span class="muted">paused</span>
                  <% } else if (r.next) { %>
                    <%= dates.formatDateShort(r.next.starts_at) %>
                  <% } else { %>
                    <span class="muted">all skipped</span>
                  <% } %>
                </td>
                <td class="right nowrap">
                  <a class="btn btn--sm" href="/admin/recurring/<%= r.id %>/edit">Edit</a>
                  <form method="post" action="/admin/recurring/<%= r.id %>/toggle" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--sm" type="submit"><%= r.is_active ? 'Deactivate' : 'Activate' %></button>
                  </form>
                  <form method="post" action="/admin/recurring/<%= r.id %>/delete" class="inline-form"
                        onsubmit="return confirm('Delete this weekly meeting for good? Skipped dates go with it.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--sm btn--danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
              <tr class="rule-skips">
                <td colspan="6">
                  <form method="post" action="/admin/recurring/<%= r.id %>/skip" class="skip-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="mono small" for="skip-<%= r.id %>">Skip a date</label>
                    <input id="skip-<%= r.id %>" name="skip_date" type="date" value="<%= r.skipDefault %>" required>
                    <button class="btn btn--sm" type="submit">Skip that week</button>
                  </form>

                  <% if (r.skips.length) { %>
                    <ul class="skip-list small">
                      <% r.skips.forEach(function (s) { %>
                        <li>
                          <span class="badge badge--warn">No meeting</span>
                          <span><%= dates.formatDate(s.skip_date + 'T12:00:00Z') %></span>
                          <form method="post" action="/admin/recurring/skips/<%= s.id %>/delete" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn--sm" type="submit">Undo</button>
                          </form>
                        </li>
                      <% }) %>
                    </ul>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <p class="section-label">Upcoming one-off meetings</p>
    <% if (!upcoming.length) { %>
      <p class="empty">Nothing scheduled yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>When</th><th>Title</th><th>Table</th><th>Marker</th><th class="right">Actions</th></tr>
          </thead>
          <tbody>
            <% upcoming.forEach(function (m) { %>
              <tr<%- m.is_cancelled ? ' class="is-cancelled"' : '' %>>
                <td>
                  <%= dates.formatDateShort(m.starts_at) %>, <%= dates.formatTime(m.starts_at) %>
                  <% if (m.is_cancelled) { %><span class="badge badge--warn">Cancelled</span><% } %>
                </td>
                <td><%= m.title || '—' %></td>
                <td><%= m.location_label || '—' %></td>
                <td class="mono small">
                  <%= (m.map_x !== null && m.map_y !== null) ? (m.map_x + ' / ' + m.map_y) : '—' %>
                </td>
                <td class="right nowrap">
                  <a class="btn btn--sm" href="/admin/meetings/<%= m.id %>/edit">Edit</a>
                  <form method="post" action="/admin/meetings/<%= m.id %>/cancel" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--sm" type="submit"><%= m.is_cancelled ? 'Un-cancel' : 'Cancel' %></button>
                  </form>
                  <form method="post" action="/admin/meetings/<%= m.id %>/delete" class="inline-form"
                        onsubmit="return confirm('Remove this meeting from the board?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--sm btn--danger" type="submit">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (past.length) { %>
      <p class="section-label">Recently past</p>
      <div class="table-wrap">
        <table class="table table--quiet">
          <thead><tr><th>When</th><th>Title</th><th>Table</th><th class="right"></th></tr></thead>
          <tbody>
            <% past.forEach(function (m) { %>
              <tr>
                <td><%= dates.formatDateShort(m.starts_at) %>, <%= dates.formatTime(m.starts_at) %></td>
                <td><%= m.title || '—' %></td>
                <td><%= m.location_label || '—' %></td>
                <td class="right"><a class="btn btn--sm" href="/admin/meetings/<%= m.id %>/edit">Edit</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
