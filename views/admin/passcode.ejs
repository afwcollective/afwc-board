<section class="section auth-section">
  <div class="wrap wrap--narrow">
    <p class="eyebrow">Leaders only</p>
    <h1>Group passcode</h1>
    <p class="lede measure">
      New members type this once when they register. It's a shared code you say
      out loud at meetings, not a personal password, so it's shown below in
      plain text for any leader to read back. If it leaks to someone outside
      the group, set a new one — existing members keep their accounts; only
      new sign-ups need the new code.
    </p>

    <%- include('../partials/form-errors', { errors: errors }) %>

    <% if (groupPasscode) { %>
      <p class="notice mono">Current passcode: <strong><%= groupPasscode %></strong></p>
    <% } else if (passcodeSet) { %>
      <p class="notice">
        A passcode is set, but not stored in a readable form (it was set before
        this page could show it back). Set a new one below to display it here.
      </p>
    <% } else { %>
      <p class="notice">
        Status: <strong>no passcode set — registration is closed</strong>
      </p>
    <% } %>

    <form method="post" action="/admin/passcode" class="form" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label for="passcode">New group passcode</label>
        <input id="passcode" name="passcode" type="text" required minlength="4" maxlength="80" autocomplete="off">
        <p class="hint">Four characters or more. Something sayable across a noisy food hall.</p>
      </div>

      <div class="field">
        <label for="passcode2">Repeat it</label>
        <input id="passcode2" name="passcode2" type="text" required minlength="4" maxlength="80" autocomplete="off">
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn--primary">Change the passcode</button>
        <a class="btn btn--sm" href="/admin">Back to admin</a>
      </div>
    </form>
  </div>
</section>
