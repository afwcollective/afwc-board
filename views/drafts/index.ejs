<section class="section">
  <div class="wrap">
    <p class="eyebrow">Members · Share when you're ready</p>
    <div class="library-head">
      <div>
        <h1>Draft library</h1>
        <p class="lede measure">
          This is the door, not an assignment — nobody's waiting on you to walk
          through it. When a page feels ready to show, it opens here: readable
          in the browser, nothing downloads. Comment page by page, or take the
          longer conversation to the draft's discussion thread.
        </p>
      </div>
      <a class="btn btn--primary" href="/drafts/new">Share a draft</a>
    </div>

    <% if (!drafts.length) { %>
      <p class="empty">
        Nothing in the library yet. <a href="/drafts/new">Be the first to open the door.</a>
      </p>
    <% } else { %>
      <ul class="draft-list">
        <% drafts.forEach(function (d) { %>
          <%
            /*
             * BYLINE: an uploader may credit the draft to a pen name instead of
             * their own display name (author_name, set on upload or from
             * /drafts/:id/edit) — NULL means "nothing was set", so the display
             * name is exactly what always showed here. Whenever a pen name
             * DIFFERS from who actually uploaded it, the uploader and any
             * leader still see that real name — moderation has to be able to
             * tell who is really behind a post — via a hover title on the
             * byline rather than a second visible line, the least-noisy way to
             * carry it. Nobody else gets that tooltip.
             */
            var draftByline = d.author_name || d.uploader_name;
            var showByAttribution = !!d.author_name && (isLeader || (currentUser && currentUser.id === d.user_id));
          %>
          <li class="card draft-card draft-card--<%= d.status %>">
            <p class="draft-meta">
              <span class="badge badge--kind"><%= kindLabel[d.kind] || d.kind %></span>
              <% if (d.status === 'processing') { %>
                <span class="badge badge--warn">Converting…</span>
              <% } else if (d.status === 'failed') { %>
                <span class="badge badge--fail">Didn’t convert</span>
              <% } %>
              <time datetime="<%= dates.isoAttr(d.created_at) %>"><%= dates.formatDateShort(d.created_at) %></time>
              <span class="draft-by"<% if (showByAttribution) { %> title="Shared by <%= d.uploader_name %>"<% } %>>· <%= draftByline %></span>
            </p>

            <h2 class="draft-title">
              <a href="/drafts/<%= d.id %>"><%= d.title %></a>
            </h2>

            <% if (d.description) { %>
              <p class="draft-desc measure"><%= d.description %></p>
            <% } %>

            <p class="draft-facts mono small">
              <% if (d.status === 'ready') { %>
                <span><%= d.page_count %> page<%= d.page_count === 1 ? '' : 's' %></span>
                <span class="dot">·</span>
              <% } %>
              <span><%= d.comment_count %> comment<%= d.comment_count === 1 ? '' : 's' %></span>
              <%# The draft's discussion is embedded in the reader now (see
                  views/drafts/show.ejs) rather than living out on the board,
                  so the library points at the section, not at the thread. %>
              <% if (d.thread_id) { %>
                <span class="dot">·</span>
                <a href="/drafts/<%= d.id %>#conversation">Conversation</a>
              <% } %>
            </p>

            <% if (d.status === 'failed') { %>
              <p class="draft-error"><%= d.error_msg || 'That file could not be converted.' %></p>
            <% } %>

            <% if (canManage(d)) { %>
              <div class="draft-actions">
                <%
                  /* Editing is the UPLOADER's call (or the architect's, the
                     board's one god-mode account) — not a plain leader's, even
                     though a leader can manage (retry/remove) this draft in
                     every other way. That covers the title, the byline, the
                     discussion topic and replacing the file itself. See
                     views/drafts/edit.ejs. */
                %>
                <% if (currentUser && (currentUser.id === d.user_id || isArchitect)) { %>
                  <a class="btn btn--sm" href="/drafts/<%= d.id %>/edit">Edit</a>
                <% } %>
                <% if (d.status === 'failed') { %>
                  <form method="post" action="/drafts/<%= d.id %>/retry" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--sm" type="submit">Try converting again</button>
                  </form>
                <% } %>
                <form method="post" action="/drafts/<%= d.id %>/delete" class="inline-form"
                      data-confirm="Remove this draft and its discussion thread?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn--sm btn--danger" type="submit">Remove</button>
                </form>
              </div>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>
