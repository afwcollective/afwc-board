<div class="reader"
     data-reader
     data-draft-id="<%= draft.id %>"
     data-kind="<%= draft.kind %>"
     data-mode="<%= mode %>"
     data-status="<%= draft.status %>"
     data-page-count="<%= draft.status === 'ready' ? draft.page_count : 0 %>"
     data-thread-id="<%= threadId || '' %>"
     data-csrf="<%= csrfToken %>">

  <div class="reader-bar">
    <div class="reader-wrap reader-bar-inner">
      <%
        /* BYLINE — see the matching comment in views/drafts/index.ejs. Same
           COALESCE and same least-noisy moderation tooltip, on the one draft
           this page is already looking at. */
        var draftByline = draft.author_name || draft.uploader_name;
        var showByAttribution = !!draft.author_name && (isLeader || (currentUser && currentUser.id === draft.user_id));
      %>
      <div class="reader-id">
        <a class="reader-back" href="/drafts" title="Back to the library">Library</a>
        <h1 class="reader-title"><%= draft.title %></h1>
        <p class="reader-by mono small">
          <span class="badge badge--kind"><%= kindLabel %></span>
          <span<% if (showByAttribution) { %> title="Shared by <%= draft.uploader_name %>"<% } %>><%= draftByline %></span>
          <% if (currentUser && (currentUser.id === draft.user_id || isArchitect)) { %>
            <span class="dot">·</span><a class="reader-edit-link" href="/drafts/<%= draft.id %>/edit">Edit byline</a>
          <% } %>
          <% if (draft.status === 'ready') { %>
            <span class="dot">·</span><%= draft.page_count %> page<%= draft.page_count === 1 ? '' : 's' %>
          <% } %>
        </p>
      </div>

      <div class="reader-tools">
        <% if (draft.status === 'ready' && mode === 'html' && sections.length > 1) { %>
          <label class="section-nav">
            <span class="visually-hidden">Jump to a section</span>
            <select data-section-nav>
              <% sections.forEach(function (s) { %>
                <option value="<%= s.page_number %>"><%= s.heading %></option>
              <% }) %>
            </select>
          </label>
        <% } %>

        <% if (draft.status === 'ready') { %>
          <div class="pager" data-pager>
            <button type="button" class="btn btn--sm" data-page-prev aria-label="Previous page">‹</button>
            <span class="pager-readout mono">
              <span data-page-current>1</span> / <span data-page-total><%= draft.page_count %></span>
            </span>
            <%# unresolved threads on the page you are looking at — comments.js fills it %>
            <span class="pager-open mono" data-page-open hidden
                  title="Open comment threads on this page"></span>
            <button type="button" class="btn btn--sm" data-page-next aria-label="Next page">›</button>
          </div>
        <% } %>

        <% if (thread) { %>
          <a class="btn btn--sm" href="#conversation">Conversation</a>
        <% } %>
      </div>
    </div>
  </div>

  <div class="reader-wrap reader-body">
    <div class="reader-main">

      <% if (draft.description) { %>
        <p class="reader-note measure"><%= draft.description %></p>
      <% } %>

      <% if (draft.status === 'processing') { %>
        <div class="card card--lead reader-state" data-processing>
          <p class="eyebrow">Converting</p>
          <h2 class="reader-state-title">Turning that into pages…</h2>
          <p class="measure">
            This usually takes a few seconds. The page refreshes itself the moment it is ready —
            you can also come back to it later from the library.
          </p>
          <p class="progress-dots" aria-hidden="true"><span></span><span></span><span></span></p>
        </div>

      <% } else if (draft.status === 'failed') { %>
        <div class="card reader-state reader-state--failed">
          <p class="eyebrow">Didn’t convert</p>
          <h2 class="reader-state-title"><%= draft.error_msg || 'That file could not be converted.' %></h2>
          <p class="measure"><%
              /* WHAT "try again" MEANS depends on WHERE CONVERSION HAPPENS, and this
                 template is shared by two apps that do it in different places. Express
                 converts server-side from the original it still holds, so a retry really
                 does cost nothing. The Cloudflare Worker converts in the uploader's
                 browser (PORT-CLOUDFLARE.md §6) and never hands an original back out, so
                 a retry there is a re-upload — worker/src/routes/drafts.js passes
                 `retryHint` to say so in the uploader's own words.

                 The guard is what keeps Express byte-identical: it sets nothing, falls
                 into the else branch, and emits exactly the whitespace and the sentence
                 it always did. Both tags are deliberately tight against the <p> and the
                 </p> for that reason — do not reformat them. */
              if (typeof retryHint !== 'undefined' && retryHint) { %><%= retryHint %><% } else { %>
            The original is still here, so trying again costs nothing — most failures are a
            file that was still being written when it was picked, or a format the converter
            could not open.
          <% } %></p>
          <% if (canManage) { %>
            <div class="draft-actions">
              <form method="post" action="/drafts/<%= draft.id %>/retry" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--primary btn--sm" type="submit">Try converting again</button>
              </form>
              <form method="post" action="/drafts/<%= draft.id %>/delete" class="inline-form"
                    data-confirm="Remove this draft and its discussion thread?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--sm btn--danger" type="submit">Remove</button>
              </form>
            </div>
          <% } %>
        </div>

      <% } else if (mode === 'html') { %>
        <article class="reader-pane reader-pane--html" data-pane>
          <div class="reader-page prose" data-page-content><%- firstPageHtml %></div>
          <%- include('../partials/watermark') %>
        </article>

      <% } else if (mode === 'pdf') { %>
        <div class="reader-pane reader-pane--pdf" data-pane>
          <div class="reader-scroller" data-scroller>
            <% pageSizes.forEach(function (p) { %>
              <div class="page-slot" data-page-slot="<%= p.page_number %>"
                   style="aspect-ratio: <%= (p.width || 612) %> / <%= (p.height || 792) %>;">
                <p class="page-slot-num mono"><%= p.page_number %></p>
              </div>
            <% }) %>
          </div>
          <noscript><p class="notice">The PDF reader needs JavaScript switched on.</p></noscript>
          <%- include('../partials/watermark') %>
        </div>

      <% } else { %>
        <div class="reader-pane reader-pane--images" data-pane>
          <div class="reader-scroller" data-scroller>
            <% pageSizes.forEach(function (p, i) { %>
              <figure class="page-slot page-slot--image" data-page-slot="<%= p.page_number %>"
                      <% if (p.width && p.height) { %>style="aspect-ratio: <%= p.width %> / <%= p.height %>;"<% } %>>
                <img src="/drafts/<%= draft.id %>/img/<%= p.page_number %>"
                     alt="Page <%= p.page_number %>"
                     draggable="false"
                     <% if (p.width) { %>width="<%= p.width %>"<% } %>
                     <% if (p.height) { %>height="<%= p.height %>"<% } %>
                     loading="<%= i < 2 ? 'eager' : 'lazy' %>" decoding="async">
                <figcaption class="page-slot-num mono"><%= p.page_number %></figcaption>
              </figure>
            <% }) %>
          </div>
          <%- include('../partials/watermark') %>
        </div>
      <% } %>
    </div>

    <% if (draft.status === 'ready') { %>
      <aside class="reader-comments" id="reader-comments" data-comments aria-label="Comments">
        <div class="rc-head">
          <p class="eyebrow">Comments</p>
          <div class="rc-scope" role="group" aria-label="Which comments to show">
            <button type="button" class="btn btn--sm is-on" data-scope="page">This page</button>
            <button type="button" class="btn btn--sm" data-scope="all">All</button>
          </div>
        </div>

        <p class="rc-context mono small" data-rc-context>Page 1</p>

        <div class="rc-list" data-comment-list>
          <p class="rc-empty">Loading…</p>
        </div>

        <form class="rc-form" data-comment-form>
          <label class="visually-hidden" for="rc-body">Start a comment thread on this page</label>
          <textarea id="rc-body" name="body" rows="3" maxlength="4000"
                    placeholder="Note on this page…"></textarea>
          <div class="rc-form-actions">
            <span class="hint mono small" data-rc-target>on page 1</span>
            <button type="submit" class="btn btn--primary btn--sm">Post</button>
          </div>
          <p class="rc-error" data-rc-error hidden></p>
        </form>
      </aside>

      <button type="button" class="rc-tab" data-comments-toggle aria-controls="reader-comments" aria-expanded="false">
        Comments <span class="rc-tab-count" data-comment-count>0</span>
      </button>
    <% } %>
  </div>

  <%# ---------------------------------------------------------------------
      THE CONVERSATION — the draft's general discussion, full width beneath the
      pages. Server-rendered and posted with a plain form (no fetch, no JS
      dependency), and it is the SAME board thread that /board/:threadId
      renders, so nothing here forks the data. Hidden entirely when a leader has
      removed the thread — see src/routes/reader.js.
      --------------------------------------------------------------------- %>
  <% if (thread) { %>
    <section class="reader-wrap draft-conversation" id="conversation">
      <p class="section-label">The conversation</p>

      <p class="dc-intro measure">
        Praise, reactions, the bigger notes that do not belong to any one page.
        Everything here is the whole draft, in the open.
        <% if (thread.is_locked) { %>
          <span class="badge badge--warn">Locked</span>
        <% } %>
      </p>

      <% if (!posts.length) { %>
        <p class="dc-empty">
          Nothing said yet. Be the first — writers remember the person who reads all the way through.
        </p>
      <% } else { %>
        <ol class="dc-list">
          <% posts.forEach(function (p) { %>
            <li class="dc-post" id="conv-<%= p.id %>">
              <p class="dc-meta mono small">
                <span class="dc-author"><%= p.author_name || 'a member' %></span>
                <time datetime="<%= dates.isoAttr(p.created_at) %>"
                      title="<%= dates.formatDateTime(p.created_at) %>"><%= dates.relative(p.created_at) %></time>
                <% if (isLeader || (currentUser && currentUser.id === p.user_id)) { %>
                  <form method="post" action="/drafts/<%= draft.id %>/conversation/<%= p.id %>/delete"
                        class="inline-form dc-del" data-confirm="Remove this post?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Remove</button>
                  </form>
                <% } %>
              </p>
              <div class="dc-body prose"><%- p.body_html %></div>
            </li>
          <% }) %>
        </ol>
      <% } %>

      <% if (!canPost) { %>
        <p class="notice">This conversation is locked. Only leaders can post here now.</p>
      <% } else { %>
        <form method="post" action="/drafts/<%= draft.id %>/conversation" class="form dc-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="conv-body">Say something about the whole draft</label>
            <textarea id="conv-body" name="body_md" rows="4" required maxlength="20000"
                      placeholder="What worked, what you would read again, what you would push on…"></textarea>
            <p class="hint">
              Plain text works. *italics*, **bold**, and blank lines between paragraphs.
              This also appears on <a href="/board/<%= thread.id %>">the board</a>.
            </p>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn--primary">Post to the conversation</button>
          </div>
        </form>
      <% } %>
    </section>
  <% } %>

  <script type="application/json" data-reader-data>
    <%- JSON.stringify({
          pageSizes: pageSizes.map(function (p) { return [p.page_number, p.width, p.height]; }),
          commentCounts: commentCounts,
          sections: sections.map(function (s) { return [s.page_number, s.heading]; })
        }).replace(/</g, '\\u003c') %>
  </script>
</div>
