<section class="hero paint-hero">
  <div class="wrap paint-inner">
    <p class="eyebrow">
      Baltimore · R. House ·
      <% if (meeting) { %>Next: <%= dates.weekday(meeting.starts_at) %><% } else { %>Fiction, out loud<% } %>
    </p>

    <div class="paint">
      <div class="paint-img" aria-hidden="true"></div>
      <h1>The Agile Fiction Writers Collective</h1>
    </div>

    <div class="hero-foot">
      <p class="lede">
        We meet at a food hall in Remington and read each other's pages. This board
        is where the time, the table and the drafts live.
      </p>
      <div class="hero-actions">
        <% if (firstRun) { %>
          <a class="btn btn--primary" href="/setup">Set up your board</a>
        <% } else if (!currentUser) { %>
          <a class="btn btn--primary" href="/register">Join the board</a>
          <a class="btn" href="/login">Sign in</a>
        <% } else { %>
          <a class="btn btn--primary" href="/drafts">Draft library</a>
          <a class="btn" href="/board">Discussion board</a>
          <%# isHost — published by loadUser: this member is running a session
              within 30 days. Used here only to offer the link. %>
          <% if (isHost) { %><a class="btn" href="/host">You're hosting</a><% } %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<% if (firstRun) { %>
  <section class="section">
    <div class="wrap">
      <div class="card card--lead">
        <p class="eyebrow">First run</p>
        <h2>Nobody has set this board up yet.</h2>
        <p class="measure">
          The first person through the door becomes a group leader, picks the shared
          passcode everyone else registers with, and sets the next meeting.
        </p>
        <p><a class="btn btn--primary" href="/setup">Set up your board</a></p>
      </div>
    </div>
  </section>
<% } else { %>

  <section class="section" id="next-meeting">
    <div class="wrap">
      <p class="section-label">Next meeting</p>

      <%
        /* An off-site event is a one-off at somebody's home. Its address and
           details are MEMBERS-ONLY: src/routes/public.js has already nulled
           them for a logged-out visitor (meetings.publicSafe), so this template
           can only render what it is allowed to. `offsite` also decides the
           right-hand column — there is no R. House table to point at, so the
           floor map is replaced rather than left empty. */
        var offsite = !!meeting && meeting.kind === 'offsite';
      %>
      <div class="meeting-grid<%= offsite ? ' meeting-grid--offsite' : '' %>">
        <div class="card card--meeting">
          <% if (meeting) { %>
            <p class="eyebrow eyebrow--muted">
              <%= dates.relative(meeting.starts_at) %><% if (meeting.is_recurring) { %> · every <%= dates.weekdayName(meeting.weekday) %><% } %>
            </p>
            <p class="meeting-date">
              <time datetime="<%= dates.isoAttr(meeting.starts_at) %>"><%= dates.formatDate(meeting.starts_at) %></time>
            </p>
            <p class="meeting-time"><%= dates.formatTime(meeting.starts_at) %></p>
            <% if (meeting.title) { %><h2 class="meeting-title"><%= meeting.title %></h2><% } %>
            <% if (offsite) { %><p><span class="badge">Off-site event</span></p><% } %>

            <dl class="meeting-facts">
              <% if (offsite) { %>
                <dt>Where</dt>
                <% if (meeting.address) { %>
                  <dd><%= meeting.address %></dd>
                <% } else { %>
                  <dd class="muted">Not at <%= site.venue %> this time — sign in for the address.</dd>
                <% } %>
              <% } else { %>
                <dt>Where</dt>
                <dd><%= site.venue %> · <%= site.venueAddress %></dd>
                <% if (meeting.location_label) { %>
                  <dt>Our table</dt>
                  <dd><span class="badge badge--rhouse">Look for us</span> <%= meeting.location_label %></dd>
                <% } %>
              <% } %>
              <% if (meeting.host_name) { %>
                <dt>Hosted by</dt>
                <dd><%= meeting.host_name %></dd>
              <% } %>
            </dl>

            <% if (meeting.notes) { %>
              <p class="meeting-notes"><%= meeting.notes %></p>
            <% } %>
          <% } else { %>
            <p class="eyebrow eyebrow--muted">Nothing on the calendar</p>
            <h2 class="meeting-title">No meeting scheduled yet.</h2>
            <p class="measure">
              A group leader will post the next date here. Check back, or
              <% if (currentUser) { %>keep an eye on the announcements below.<% } else { %>
                <a href="/register">join the board</a> so you don't miss it.<% } %>
            </p>
            <% if (isLeader) { %>
              <p><a class="btn btn--primary" href="/admin/meetings/new">Schedule one</a></p>
            <% } %>
          <% } %>
        </div>

        <% if (offsite) { %>
          <div class="card event-panel">
            <% if (currentUser) { %>
              <p class="section-label">Event details</p>
              <% if (meeting.body_html) { %>
                <div class="prose"><%- meeting.body_html %></div>
              <% } else { %>
                <p class="empty">No extra details — just the address and the time.</p>
              <% } %>

              <% if (eventAttachments.length) { %>
                <p class="eyebrow eyebrow--muted">Attachments</p>
                <ul class="file-list">
                  <% eventAttachments.forEach(function (f) { %>
                    <li>
                      <a href="/events/<%= f.meeting_id %>/files/<%= f.id %>" target="_blank" rel="noopener">
                        <%= f.original_name || 'Attachment' %>
                      </a>
                      <span class="mono small muted"><%= Math.max(1, Math.round((f.size || 0) / 1024)) %> KB</span>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
            <% } else { %>
              <p class="section-label">Members only</p>
              <h3 class="event-teaser-title">Off-site event — sign in for the details.</h3>
              <p class="measure">
                This one isn't at <%= site.venue %>. The address, the directions
                and anything attached to it are for members of the group, so
                they stay behind the sign-in.
              </p>
              <p class="hero-actions">
                <a class="btn btn--primary" href="/login">Sign in</a>
                <a class="btn" href="/register">Join the board</a>
              </p>
            <% } %>
          </div>
        <% } else { %>
          <div class="map-panel">
            <%- include('partials/floormap', {
                  markerX: meeting ? meeting.map_x : null,
                  markerY: meeting ? meeting.map_y : null,
                  interactive: false
                }) %>
          </div>
        <% } %>
      </div>

      <% if (weekly.length) { %>
        <div class="weekly-strip">
          <p class="weekly-strip-label">The staples</p>
          <ul class="weekly-list">
            <% weekly.forEach(function (r) { %>
              <li class="weekly-item">
                Every <%= dates.weekdayName(r.weekday) %>
                <span class="weekly-sep">·</span> <%= dates.formatHhmm(r.time_hhmm) %>
                <% if (r.title) { %>
                  <span class="weekly-sep">·</span> <span class="weekly-where"><%= r.title %></span>
                <% } %>
                <% if (r.location_label) { %>
                  <span class="weekly-sep">·</span> <span class="weekly-where"><%= r.location_label %></span>
                <% } %>
              </li>
            <% }) %>
          </ul>
          <p class="weekly-strip-note small muted">
            These run every week, on the calendar for good — everything else on
            this page is the exception, not the rule.
          </p>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section" id="how-it-runs">
    <div class="wrap">
      <p class="section-label">How a session runs</p>
      <div class="prose measure">
        <p>
          A session runs two hours: the first ten minutes are for settling in,
          coffee and catching up, and then the writing starts.
        </p>
        <p>
          From there it's twenty-minute sprints with ten-minute breaks between
          them — write, stop, talk, go again — until the two hours are up.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--band" id="about">
    <div class="wrap">
      <p class="section-label">The collective</p>
      <div class="prose measure"><%- aboutHtml %></div>
    </div>
  </section>

  <section class="section" id="announcements">
    <div class="wrap">
      <p class="section-label">News &amp; announcements</p>

      <% if (!pinnedAnnouncements.length && !recentAnnouncements.length) { %>
        <p class="empty">No announcements yet. When a leader posts one it shows up here.</p>
      <% } else { %>

        <% if (pinnedAnnouncements.length) { %>
          <ul class="ann-list ann-list--featured">
            <% pinnedAnnouncements.forEach(function (a) { %>
              <li class="card ann ann--pinned">
                <p class="ann-meta">
                  <span class="badge">Pinned</span>
                  <time datetime="<%= dates.isoAttr(a.created_at) %>"><%= dates.formatDateShort(a.created_at) %></time>
                  <% if (a.author_name) { %><span class="ann-author">· <%= a.author_name %></span><% } %>
                </p>
                <h3 class="ann-title"><%= a.title %></h3>
                <div class="prose measure"><%- a.body_html %></div>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <% if (recentAnnouncements.length) { %>
          <% if (pinnedAnnouncements.length) { %><p class="ann-recent-label mono small muted">Also recently</p><% } %>
          <ul class="ann-compact-list">
            <% recentAnnouncements.forEach(function (a) { %>
              <li class="ann-compact-item">
                <p class="ann-meta">
                  <time datetime="<%= dates.isoAttr(a.created_at) %>"><%= dates.formatDateShort(a.created_at) %></time>
                  <% if (a.author_name) { %><span class="ann-author">· <%= a.author_name %></span><% } %>
                </p>
                <h3 class="ann-compact-title"><%= a.title %></h3>
                <% if (a.snippet) { %><p class="muted small"><%= a.snippet %></p><% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      <% } %>

      <% if (isLeader) { %>
        <p class="section-foot"><a class="btn btn--sm" href="/admin/announcements">Post an announcement</a></p>
      <% } %>
    </div>
  </section>

  <section class="section section--band" id="special-events">
    <div class="wrap">
      <p class="section-label">Special events</p>

      <% if (!specialEvents.length) { %>
        <p class="empty">Nothing extra on the calendar — the weekly sessions roll on.</p>
      <% } else { %>
        <ul class="special-list">
          <% specialEvents.forEach(function (m) { %>
            <% var mOffsite = m.kind === 'offsite'; %>
            <li class="card special-card">
              <p class="ann-meta">
                <time datetime="<%= dates.isoAttr(m.starts_at) %>"><%= dates.formatDateShort(m.starts_at) %></time>
                <span class="weekly-sep">·</span> <%= dates.formatTime(m.starts_at) %>
                <% if (mOffsite) { %><span class="badge">Off-site</span><% } else { %><span class="badge badge--rhouse">R. House</span><% } %>
              </p>
              <h3 class="ann-title"><%= m.title || 'Untitled gathering' %></h3>
              <% if (mOffsite) { %>
                <% if (m.address) { %>
                  <p class="muted small"><%= m.address %></p>
                <% } else { %>
                  <p class="muted small">Off-site — sign in for the address.</p>
                <% } %>
              <% } else if (m.location_label) { %>
                <p class="muted small"><%= m.location_label %></p>
              <% } %>
              <% if (m.host_name) { %><p class="muted small">Hosted by <%= m.host_name %></p><% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <% if (isLeader) { %>
        <p class="section-foot"><a class="btn btn--sm" href="/admin/meetings/new">Schedule an event</a></p>
      <% } %>
    </div>
  </section>

  <% if (!currentUser) { %>
    <section class="section" id="join-cta">
      <div class="wrap">
        <div class="card card--lead">
          <p class="eyebrow">Join us</p>
          <h2>Come write with us.</h2>
          <p class="measure">
            New writers are always welcome — drop into a session, no submission
            and no obligation to share what you're working on.
          </p>
          <p class="hero-actions">
            <a class="btn btn--primary" href="/register">Join the board</a>
            <a class="btn" href="/login">Sign in</a>
          </p>
        </div>
      </div>
    </section>
  <% } %>
<% } %>
